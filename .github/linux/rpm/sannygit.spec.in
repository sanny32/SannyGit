%global debug_package %{nil}

Name:           sannygit
Version:        %{app_version}
Release:        %{app_release}%{?dist}
Summary:        Desktop Git client
License:        MIT AND OFL-1.1
URL:            https://github.com/sanny32/SannyGit
ExclusiveArch:  x86_64
Requires:       hicolor-icon-theme
Requires:       git >= 2.36
# Window-system libraries are loaded dynamically and escape automatic ELF scanning.
Requires:       libxkbcommon.so.0()(64bit), libxkbcommon-x11.so.0()(64bit)
Requires:       libwayland-client.so.0()(64bit), libwayland-cursor.so.0()(64bit)
Requires:       libEGL.so.1()(64bit), libGL.so.1()(64bit)
Requires:       libX11.so.6()(64bit), libXcursor.so.1()(64bit)
Requires:       libXrandr.so.2()(64bit), libXi.so.6()(64bit)
Requires:       libxcb.so.1()(64bit), libxcb-randr.so.0()(64bit)

%description
Compact Git client built with Rust and egui.

%install
mkdir -p %{buildroot}
cp -a %{stage_root}/usr %{buildroot}/

%files
/usr/bin/sannygit
/usr/share/applications/io.github.sanny32.SannyGit.desktop
/usr/share/icons/hicolor/256x256/apps/sannygit.png
/usr/share/icons/hicolor/scalable/apps/sannygit.svg
%dir /usr/share/licenses/sannygit
%license /usr/share/licenses/sannygit/LICENSE
%license /usr/share/licenses/sannygit/SourceSans3-OFL.txt
